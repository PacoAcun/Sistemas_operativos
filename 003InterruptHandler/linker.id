ENTRY(_start)

SECTIONS
{
    . = 0x00010000;
    
    .text : {
        *(.vectors)
        *(.text*)
    }
    
    .rodata : {
        *(.rodata*)
    }
    
    .data : {
        *(.data*)
    }
    
    . = ALIGN(4);
    __bss_start = .;
    .bss : {
        *(.bss*)
        *(COMMON)
    }
    . = ALIGN(4);
    __bss_end = .;
}